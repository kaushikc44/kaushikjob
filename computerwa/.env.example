# Solana RPC used by the browser. Devnet only — never point this at mainnet.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# "devnet" or "localnet" (label + explorer links). Mainnet is rejected at runtime.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- Live inference dashboard (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_) ---
# Public URL of the gateway on the Mac mini (e.g. Tailscale Funnel / Cloudflare Tunnel hostname).
INFERENCE_GATEWAY_URL=
# A gateway key with ONLY the usage:read scope:  npm run gateway:keys -- create dashboard --scopes usage:read
INFERENCE_GATEWAY_READ_KEY=
