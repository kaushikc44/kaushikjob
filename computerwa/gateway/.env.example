# ComputeRWA inference gateway — runs on the Mac mini next to the model server.
# Copy to gateway/.env and load it (e.g. `set -a; source gateway/.env; set +a`). Never commit the real file.

# Where the gateway listens. Keep 127.0.0.1 and expose it with Tailscale / Cloudflare Tunnel,
# or bind to the Mac's LAN/Tailscale IP. Never expose the model server port itself.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# OpenAI-compatible model server on the same machine (Ollama default shown).
#   Ollama:        http://127.0.0.1:11434/v1
#   LM Studio:     http://127.0.0.1:1234/v1
#   llama-server:  http://127.0.0.1:8080/v1
#   mlx_lm.server: http://127.0.0.1:8080/v1
UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
# REQUIRED: the exact model tag your runtime serves (check `ollama list` or GET /v1/models).
UPSTREAM_MODEL=
# Optional name shown to API clients instead of the upstream tag.
PUBLIC_MODEL_ID=gemma-4
# Only if your runtime requires one (e.g. LM Studio with auth enabled).
UPSTREAM_API_KEY=

GATEWAY_KEYS_FILE=gateway-data/keys.json
GATEWAY_LEDGER_FILE=gateway-data/usage.jsonl

# Limits
MAX_BODY_BYTES=32768
MAX_MESSAGES=32
DEFAULT_MAX_TOKENS=256
MAX_OUTPUT_TOKENS=1024
UPSTREAM_TIMEOUT_MS=60000
READINESS_TIMEOUT_MS=3000
GLOBAL_CONCURRENCY=2
PER_KEY_CONCURRENCY=1
RATE_LIMIT_PER_MINUTE=20
IDEMPOTENCY_TTL_HOURS=24

# Cost ASSUMPTIONS (estimates, not measurements). Measure power with `sudo powermetrics` or a wall meter.
COST_POWER_WATTS=40
COST_ELECTRICITY_USD_PER_KWH=0.22
COST_HARDWARE_USD=0
COST_HARDWARE_LIFETIME_HOURS=26280
COST_NOTE=
